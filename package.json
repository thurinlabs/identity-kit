{
  "name": "@thurinlabs/identity-kit",
  "version": "2.0.0",
  "description": "Check Thurin.id claims (PGP keys on Ethereum addresses) in Node, workers, or the browser",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/thurinlabs/identity-kit.git"
  },
  "homepage": "https://docs.thurin.id/#/sdk",
  "bugs": {
    "url": "https://github.com/thurinlabs/identity-kit/issues"
  },
  "type": "module",
  "main": "dist/index.cjs",
  "module": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./core": {
      "types": "./dist/core.d.ts",
      "import": "./dist/core.js",
      "require": "./dist/core.cjs"
    }
  },
  "sideEffects": false,
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup",
    "test": "vitest run",
    "test:watch": "vitest",
    "prepublishOnly": "node -e \"const o=require('child_process').execSync('git status --porcelain').toString().trim(); if (o) { console.error('Refusing to publish: uncommitted changes. npm would ship whatever dist/ holds, not a commit.\\n'+o); process.exit(1) }\" && npm test && npm run build"
  },
  "peerDependencies": {
    "viem": ">=2"
  },
  "dependencies": {
    "eckey-utils": "^0.7.14",
    "openpgp": "^6.3.0"
  },
  "devDependencies": {
    "tsup": "^8.0.0",
    "typescript": "^5.5.0",
    "viem": "^2.21.0",
    "vitest": "^2.0.0"
  },
  "license": "MIT"
}
